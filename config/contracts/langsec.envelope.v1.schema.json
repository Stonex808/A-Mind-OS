{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://refocus-os.local/contracts/langsec.envelope.v1.schema.json",
  "title": "LangSec Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "timestamp", "src", "dst", "verb", "payload", "budget", "signature", "schema_version"],
  "properties": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._:-]+$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "src": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
    "dst": {"type": "string", "const": "lg_a_langsec"},
    "verb": {"type": "string", "enum": ["security.scan_prompt", "security.scan_context", "security.review_output"]},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content", "content_type", "policy_mode", "redact_fields"],
      "properties": {
        "content": {"type": "string", "minLength": 1, "maxLength": 20000},
        "content_type": {"type": "string", "enum": ["prompt", "context", "output"]},
        "policy_mode": {"type": "string", "enum": ["strict", "balanced", "audit"]},
        "redact_fields": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "maxItems": 64,
          "uniqueItems": true
        },
        "caller_risk": {"type": "string", "enum": ["low", "medium", "high"]}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_tokens", "max_ms", "priority"],
      "properties": {
        "max_tokens": {"type": "integer", "minimum": 1},
        "max_ms": {"type": "integer", "minimum": 1},
        "priority": {"type": "string", "enum": ["low", "normal", "high", "critical"]},
        "max_depth": {"type": "integer", "minimum": 1},
        "cost_center": {"type": "string", "minLength": 1}
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": {"type": "string", "const": "ed25519"},
        "key_id": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 32}
      }
    },
    "schema_version": {"type": "string", "const": "1.0.0"}
  }
}
